@startuml
skinparam shadowing false
skinparam sequence {
    ArrowColor #006666
    ActorBorderColor #006666
    LifeLineBorderColor #006666
    ParticipantBorderColor #006666
    ParticipantBackgroundColor #E0F2F1
}

title Sequence Diagram 3: Creazione, Modifica ed Eliminazione Ristorante (Ristoratore)

actor "Ristoratore\nLoggato" as Rist
participant "FinestraRistoratore\n(GUI Client)" as GUI
participant "ControllerTheKnife\n(Client)" as Ctrl
participant "SessioneUtente\n(Client)" as Sess
participant "ServerTK\n(RMI Server)" as Server
participant "RistoranteDAO" as RistDAO
participant "RecensioneDAO" as RecDAO
database "PostgreSQL\n(the_knife)" as DB

== 1. Visualizzazione Miei Ristoranti e Riepilogo Valutazioni ==
Rist -> GUI : Accede alla Pagina Ristoratore
activate GUI
GUI -> Ctrl : visualizzaMieiRistoranti()
activate Ctrl
Ctrl -> Sess : verificaPermessoRistoratore()
Sess --> Ctrl : true (idRistoratore)
Ctrl -> Server : getRistorantiPerRistoratore(idRistoratore) [RMI]
activate Server
Server -> RistDAO : getRistorantiPerRistoratore(idRistoratore)
activate RistDAO
RistDAO -> DB : SELECT * FROM RistorantiTheKnife WHERE id_ristoratore = ?
activate DB
DB --> RistDAO : Lista Ristoranti del gestore
deactivate DB
RistDAO --> Server : List<Ristorante>
deactivate RistDAO
Server --> Ctrl : List<Ristorante>
deactivate Server
Ctrl --> GUI : List<Ristorante>
deactivate Ctrl

loop Per ogni ristorante gestito
    GUI -> Ctrl : visualizzaRiepilogo(idRistorante)
    Ctrl -> Server : visualizzaRiepilogo(idRistorante) [RMI]
    Server -> RecDAO : visualizzaRiepilogo(idRistorante)
    RecDAO -> DB : SELECT COUNT(*), COALESCE(AVG(stelle), 0) FROM Recensioni...
    DB --> GUI : Media stelle e totale recensioni
end
deactivate GUI

== 2. Creazione Nuovo Ristorante ==
Rist -> GUI : Clicca "Aggiungi", compila il form\ne clicca "Crea Ristorante"
activate GUI
GUI -> Ctrl : aggiungiRistorante(nuovoRistorante)
activate Ctrl
Ctrl -> Sess : verificaPermessoRistoratore()
Sess --> Ctrl : idRistoratore
Ctrl -> Server : synchronized aggiungiRistorante(nuovoRistorante, idRistoratore) [RMI]
activate Server
Server -> RistDAO : aggiungiRistorante(r, idRistoratore)
activate RistDAO
RistDAO -> DB : INSERT INTO RistorantiTheKnife ... SELECT ... WHERE LOWER(ruolo) = 'ristoratore'
activate DB
DB --> RistDAO : 1 riga inserita
deactivate DB
RistDAO --> Server : true
deactivate RistDAO
Server --> Ctrl : true
deactivate Server
Ctrl --> GUI : true
deactivate Ctrl
GUI -> GUI : caricaMieiRistoranti() (Aggiorna tabella)
deactivate GUI

== 3. Modifica Ristorante Esistente ==
Rist -> GUI : Seleziona un ristorante, clicca "Modifica",\naggiorna i dati e clicca "Salva Modifiche"
activate GUI
GUI -> Ctrl : modificaRistorante(ristoranteAggiornato)
activate Ctrl
Ctrl -> Server : synchronized modificaRistorante(r, idRistoratore) [RMI]
activate Server
Server -> RistDAO : modificaRistorante(r, idRistoratore)
activate RistDAO
RistDAO -> DB : UPDATE RistorantiTheKnife SET nome=?, ... WHERE id_ristorante=? AND id_ristoratore=?
activate DB
DB --> RistDAO : 1 riga aggiornata
deactivate DB
RistDAO --> Server : true
deactivate RistDAO
Server --> Ctrl : true
deactivate Server
Ctrl --> GUI : true
deactivate Ctrl
GUI -> GUI : caricaMieiRistoranti() (Aggiorna tabella)
deactivate GUI

== 4. Eliminazione Ristorante ==
Rist -> GUI : Seleziona un ristorante, clicca "Elimina"\ne conferma la cancellazione
activate GUI
GUI -> Ctrl : eliminaRistorante(idRistorante)
activate Ctrl
Ctrl -> Server : synchronized eliminaRistorante(idRistorante, idRistoratore) [RMI]
activate Server
Server -> RistDAO : eliminaRistorante(idRistorante, idRistoratore)
activate RistDAO
RistDAO -> DB : DELETE FROM RistorantiTheKnife WHERE id_ristorante=? AND id_ristoratore=?
activate DB
DB --> RistDAO : 1 riga eliminata (CASCADE su Recensioni/Preferiti)
deactivate DB
RistDAO --> Server : true
deactivate RistDAO
Server --> Ctrl : true
deactivate Server
Ctrl --> GUI : true
deactivate Ctrl
GUI -> GUI : caricaMieiRistoranti() e svuota tabella recensioni
deactivate GUI
@enduml